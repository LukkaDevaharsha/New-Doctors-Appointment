NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Dedicated MySQL database (create it once before starting the API).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=doctors_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_DATABASE=doctors_appointment_db
MYSQL_POOL_SIZE=10

# Synthetic patient login seed only; set a private test value before running the Aiven seed script.
UI_TEST_PATIENT_PASSWORD=replace-with-a-private-test-password

# Use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Safe local development transport; does not contact SMTP or send real email.
EMAIL_MODE=mock
EMAIL_FROM=Doctor Appointment System <no-reply@example.test>

# Production Gmail SMTP settings. Put the Google App Password only in protected environment settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Resend limits; additionally limited to one send per account per minute in the database.
RESEND_IP_WINDOW_MS=900000
RESEND_IP_MAX=10
RESEND_EMAIL_WINDOW_MS=3600000
RESEND_EMAIL_MAX=3

# Private local storage, outside frontend/public and static serving.
PRIVATE_STORAGE_DIR=./private-uploads
MAX_DOCUMENT_SIZE_BYTES=10485760
