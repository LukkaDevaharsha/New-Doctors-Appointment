NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Dedicated MySQL database (create it once before starting the API).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=doctors_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_DATABASE=doctors_appointment_db
MYSQL_POOL_SIZE=10

# Use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Safe local development transport; prints a verification message to the backend console.
EMAIL_MODE=mock
EMAIL_FROM=Doctor Appointment System <no-reply@example.test>

# Configure SMTP and EMAIL_MODE=smtp for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Private local storage, outside frontend/public and static serving.
PRIVATE_STORAGE_DIR=./private-uploads
MAX_DOCUMENT_SIZE_BYTES=10485760
